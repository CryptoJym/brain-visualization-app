{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cortex-compass",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "6f349de117d99a881f37713f4faad62e",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "cortexcompass.utlyze.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTRAIT_IMAGES",
      "bucket_name": "cortex-compass-private-portraits"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTRAIT_SERVICE",
        "class_name": "PortraitService"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cc-xai-portraits-v1",
      "new_sqlite_classes": [
        "PortraitService"
      ]
    }
  ],
  "vars": {
    "PORTRAIT_TOTAL_LIMIT": "100"
  },
  "observability": {
    "enabled": false
  }
}
